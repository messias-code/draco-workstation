# Chaves de API para enriquecimento das vulnerabilidades
# Copie este arquivo para .env e preencha suas chaves. O arquivo .env será ignorado pelo git.

# NVD API Key (National Vulnerability Database) - Aumenta o limite de consultas para 50/30seg
NVD_API_KEY=

# Vulners API Key - Para maior riqueza de correlações e explorações
VULNERS_API_KEY=
